PORT=3847
DATABASE_PATH=./data/promo.db
AUTH_DIR=./data/whatsapp-auth

# Intervalo base entre publicações (minutos) — o anti-ban adiciona jitter
DEFAULT_INTERVAL_MINUTES=45

# Regras anti-ban (valores conservadores)
# Regras anti-ban — cadência conservadora (não copiar 2–5 min dos concorrentes)
ANTIBAN_MIN_DELAY_SEC=720
ANTIBAN_MAX_DELAY_SEC=1200
ANTIBAN_MAX_PER_HOUR=5
ANTIBAN_MAX_PER_DAY=40
ANTIBAN_MAX_GROUPS_PER_WAVE=1
ANTIBAN_COOLDOWN_AFTER_WAVE_MIN=12
ANTIBAN_QUIET_START=22
ANTIBAN_QUIET_END=9
ANTIBAN_WARMUP_DAYS=14
ANTIBAN_WARMUP_MAX_PER_DAY=40
ANTIBAN_SAME_TEXT_COOLDOWN_MIN=180

# Segredo do cofre de credenciais (AES-256-GCM). Troque em produção.
CREDENTIALS_SECRET=troque-esta-chave-longa-e-aleatoria

# Amazon Associates — Product Advertising API 5 (NÃO é senha da conta Amazon)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.com.br
AMAZON_REGION=us-east-1

# Mercado Livre Criadores/Afiliados — automação do Hub
# Conta = username do /social/... (ex.: ocarafmz). NÃO use ID de produto (RLHYPL-3RZ4).
# Sessão do Hub (F12 → createLink): Cookie + CSRF + etiqueta — necessários para GANHOS EXTRAS + meli.la
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_AFFILIATE_TAG=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_HUB_COOKIE=
ML_HUB_CSRF=
ML_HUB_TAG=

# Shopee Affiliates
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_AFFILIATE_ID=

# Magalu / Magazine Você
MAGALU_AFFILIATE_TOKEN=
MAGALU_PARTNER_ID=

# Awin (Americanas e outras lojas)
AWIN_PUBLISHER_ID=
AWIN_API_KEY=

# Revalidação contínua de cupons (minutos)
COUPON_REVALIDATE_MINUTES=8

# true = ofertas de demonstração sem APIs
DEMO_MODE=true
